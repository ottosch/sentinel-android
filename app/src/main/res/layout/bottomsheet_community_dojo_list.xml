<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
    tools:ignore="HardcodedText">

    <!-- The title is its own TextView so it can wrap to two lines: the
         toolbar's built-in title is one line and was cut off on narrow
         screens. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/communityDojoToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_baseline_arrow_back_24"
        app:menu="@menu/community_dojo_list_menu">

        <TextView
            android:id="@+id/communityDojoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingVertical="8dp"
            android:text="@string/community_dojo_toolbar_title"
            android:textAppearance="?attr/textAppearanceHeadline6" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Shown over a saved list: refreshing, Dojo Bay unreachable, or no operator statement. -->
    <LinearLayout
        android:id="@+id/communityDojoBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/community_dojo_banner_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/communityDojoBannerIcon"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/circle_shape"
            app:tint="@color/warning_yellow" />

        <TextView
            android:id="@+id/communityDojoBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="10dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="Dojo Bay unreachable · showing list from 15 Nov 2026, 13:40" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/communityDojoBannerRetry"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/community_dojo_retry"
            android:textColor="@color/green_ui_2"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/communityDojoStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="14sp"
        tools:text="Connecting via Tor…" />

    <ProgressBar
        android:id="@+id/communityDojoProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/communityDojoRetryButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="@string/community_dojo_retry"
        android:textColor="@color/green_ui_2"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/communityDojoChangeAddressButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/community_dojo_change_address"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:visibility="gone" />

    <!-- Snackbars are shown in this CoordinatorLayout, inside the sheet. Without
         it a Snackbar finds the dialog's own coordinator and is drawn under
         the sheet (lower elevation), unreadable. -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/communityDojoSnackbarHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/communityDojoRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:visibility="gone"
            tools:listitem="@layout/item_community_dojo" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</LinearLayout>

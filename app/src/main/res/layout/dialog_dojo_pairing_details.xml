<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole body scrolls, and the lead-in message lives here rather than on
  the builder. An AlertDialog with both setMessage and setView has two
  middle panels, so AlertDialogLayout falls back to a plain LinearLayout
  measure and a tall body (the signer section) pushes Pair / Don't pair
  off the bottom of the screen. With one scrolling middle panel the
  buttons are measured first and always stay on screen.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dojoPairingScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:scrollbarStyle="outsideOverlay"
    android:scrollbars="vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/dojoPairingMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?attr/materialAlertDialogBodyTextStyle"
        android:layout_marginBottom="12dp"
        android:importantForAccessibility="yes"
        tools:text="@string/dojo_pairing_confirm_message" />

    <!--
      #256: the PRE-PAIR confirmation dialog's detail view, carried by
      MaterialAlertDialogBuilder.setView. The title stays on the builder; the
      lead-in message is the first view above, in the dialog's message style.
      Grey 12sp labels over white 13sp values, values
      wrapped - the fragment_dojo_credentials_bottomsheet row idiom - so
      long onion URLs never bleed into neighboring rows. The directory
      header and the jurisdiction/version/explorer rows default hidden:
      code shows a row only when it carries real data (absent means
      absent, never a placeholder); the URL row is the one guarantee
      (validate) and defaults visible.
    -->
    <LinearLayout
        android:id="@+id/dojoPairingDirectoryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/dojoPairingDirectoryFlag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:textSize="22sp"
            tools:text="SG" />

        <TextView
            android:id="@+id/dojoPairingDirectoryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Community Dojo" />
    </LinearLayout>

    <!-- What the signature covers, and which rows come from the listing. -->
    <TextView
        android:id="@+id/dojoPairingDirectoryCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/dojo_pairing_directory_not_signed"
        android:textColor="#9A9A9A"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/dojoPairingJurisdictionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dojo_pairing_row_jurisdiction"
            android:textColor="#9A9A9A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dojoPairingJurisdictionValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="Singapore" />
    </LinearLayout>

    <!-- #250: the network row - evidence only (directory label or URL
         whisper), rendered by the sheet when either is present; absent
         means absent, never a placeholder. -->
    <LinearLayout
        android:id="@+id/dojoPairingNetworkRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dojo_pairing_row_network"
            android:textColor="#9A9A9A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dojoPairingNetworkValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="Testnet" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dojoPairingUrlRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dojo_pairing_row_url"
            android:textColor="#9A9A9A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dojoPairingUrlValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="http://abcdef123456.onion/v2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dojoPairingVersionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dojo_pairing_row_version"
            android:textColor="#9A9A9A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dojoPairingVersionValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="1.29.2" />

        <!-- Where the version above was checked. Hidden with the row. -->
        <TextView
            android:id="@+id/dojoPairingVersionSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/dojo_pairing_version_source"
            android:textColor="#9A9A9A"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dojoPairingExplorerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dojo_pairing_row_explorer"
            android:textColor="#9A9A9A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dojoPairingExplorerValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="http://explorer.example" />
    </LinearLayout>

    <!--
      Who signed the listing: the full payment code the listing's signature
      proved, never the directory's paymentCode or paynym fields. Shown only
      for a pick from the Community Dojos list. The avatar and +name come
      from PayNym over Tor (PayNymLookup) and stay hidden until they load.
    -->
    <LinearLayout
        android:id="@+id/dojoPairingSignerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dojo_pairing_row_signed_by"
            android:textColor="#9A9A9A"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/dojoPairingSignerIdentity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/dojoPairingSignerAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#303030"
                android:contentDescription="@string/paynym_avatar_description"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/SignerAvatarShape" />

            <LinearLayout
                android:id="@+id/dojoPairingSignerMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/dojoPairingSignerNym"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    tools:text="+examplenym" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/paynym_from_caption"
                    android:textColor="#9A9A9A"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/dojoPairingSignerCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:breakStrategy="simple"
            android:fontFamily="@font/roboto_mono"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/white"
            android:textIsSelectable="true"
            android:textSize="12sp"
            tools:text="PM8T JUJH kfdj kb5g 5XaJ uvnC 63rU z7LX" />

        <TextView
            android:id="@+id/dojoPairingSignerLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:text="@string/paynym_view_link"
            android:textColor="@color/green_ui_2"
            android:textSize="14sp"
            app:drawableEndCompat="@drawable/ic_open_in_new_16"
            app:drawableTint="@color/green_ui_2" />

        <!-- Another listing in the list uses this name with a different signer. -->
        <LinearLayout
            android:id="@+id/dojoPairingSignerCollision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/signer_collision_background"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/signer_warning_dot" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dojo_pairing_signer_collision"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground">


    <!--
        #429: the title column is a vertical LinearLayout so the badge
        can toggle GONE/VISIBLE without disturbing the constraint math -
        a GONE TextView wired between the title and the parent edge
        drops its own margins in ConstraintLayout, which would shrink
        every normal row by the old 32dp bottom margin. The container
        inherits the title's exact outer geometry (16/32/3/32 margins,
        bottom-to-parent anchor), so normal rows render pixel-identical
        to master; a visible badge grows the wrap_content row.
    -->
    <LinearLayout
        android:id="@+id/rvItemCollectionTextColumn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="3dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline2"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/rvItemCollectionIcon"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/rvItemCollectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:text="TextView"
            android:textSize="14sp" />

        <!--
            #429: off-network badge, last text line of the left column.
            maxLines=2 + ellipsize=end: wrap or ellipsize, never clip
            (decision 2, frozen on the issue).
        -->
        <TextView
            android:id="@+id/rvItemCollectionBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/rvItemCollectionIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="24dp"
        android:contentDescription="wallet icon"
        android:tint="#E4E4E4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_baseline_wallet_24" />

    <TextView
        android:id="@+id/rvItemCollectionBalance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="TextView"
        android:ellipsize="end"
        android:gravity="end"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/rvItemCollectionTextColumn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toTopOf="@+id/rvItemCollectionTextColumn" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.58" />

</androidx.constraintlayout.widget.ConstraintLayout>
